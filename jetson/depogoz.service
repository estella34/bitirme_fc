# Jetson'da DepoGöz sunucusunu açılışta başlatan systemd birimi.
# Kurulum:
#   sudo cp jetson/depogoz.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now depogoz
# Kullanıcı adı ve yollar: depogoz_fc, ~/bitirme. Veri ~/depogoz-veri altında; NVMe takılınca /data'ya taşınır.

[Unit]
Description=DepoGöz sunucusu (API + arayüz)
After=network-online.target
Wants=network-online.target

[Service]
User=depogoz_fc
WorkingDirectory=/home/depogoz_fc/bitirme/backend
Environment=ENVANTER_DATA_DIR=/home/depogoz_fc/depogoz-veri
ExecStart=/home/depogoz_fc/bitirme/backend/.venv/bin/depogoz serve --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
